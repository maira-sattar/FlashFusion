// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

model User {
  id                Int        @id @default(autoincrement())
  name              String     @db.VarChar(255)
  email             String     @unique
  password          String     @unique
  phone             String     @unique
  is_active         Boolean    @default(true)
  role              UserRole
  email_verified_at DateTime?
  // Relations 
  addresses         Address[]
  likes             UserLike[]
  otps              Otp?
  cart              Cart?
  orders            Order[]

  //Time Stamp
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Address {
  id            Int    @id @default(autoincrement())
  address_title String
  postal_code   String
  house_number  String
  city          String
  latitude      String
  longitude     String
  address       String @db.VarChar(255)

  // Relations 

  user    User @relation(fields: [user_id], references: [id])
  user_id Int

  //Time Stamp

  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
}

model Hash {
  email      String   @unique
  hash       String
  created_at DateTime @default(now())
}

model Otp {
  id   Int @id @default(autoincrement())
  code Int

  user_email String    @unique
  // relations
  user       User      @relation(fields: [user_email], references: [email])
  // Time stamp
  expires_at DateTime?
  created_at DateTime  @default(now())
}

model ProductCategory {
  id         Int       @id @default(autoincrement())
  title      String
  is_active  Boolean   @default(true)
  products   Product[]
  deleted_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  img        Image?
  home       Home?     @relation(fields: [homeId], references: [id])
  homeId     Int?
}

model Product {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  description   String?
  categoryId    Int
  discountId    Int?
  discountStart DateTime?
  discountEnd   DateTime?
  isActive      Boolean   @default(true)
  stockQuantity Int       @default(0)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  currency      String    @default("PKR")

  // Relations
  category      ProductCategory   @relation(fields: [categoryId], references: [id])
  discount      Discount?         @relation(fields: [discountId], references: [id])
  variants      ProductVariant[]
  images        Image[]
  homePageLinks HomePageProduct[]
  likedByUsers  UserLike[]
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model Discount {
  id                  Int       @id @default(autoincrement())
  title               String
  scale               Float
  restaurant_discount String
  products            Product[]
}

model ProductVariant {
  id        Int    @id @default(autoincrement())
  productId Int
  label     String
  price     Float

  product Product @relation(fields: [productId], references: [id])
}

model Image {
  id           Int              @id @default(autoincrement())
  url          String
  image_type   String
  // user       User      @relation(fields: [user_email], references: [email])
  productCat   ProductCategory? @relation(fields: [productCatId], references: [id])
  productCatId Int?             @unique

  product   Product? @relation(fields: [productId], references: [id])
  productId Int?

  home   Home? @relation(fields: [homeId], references: [id])
  homeId Int?
}

model HomePageProduct {
  id         Int      @id @default(autoincrement())
  homePageId Int
  productId  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
}

model UserLike {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([userId, productId])
  @@map("user_likes")
}

model Cart {
  id        Int        @id @default(autoincrement())
  user      User       @relation(fields: [userId], references: [id])
  userId    Int        @unique
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cart      Cart     @relation(fields: [cartId], references: [id])
  cartId    Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id         Int         @id @default(autoincrement())
  user       User        @relation(fields: [userId], references: [id])
  userId     Int
  items      OrderItem[]
  status     OrderStatus @default(PENDING)
  totalPrice Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   Int
  product   Product  @relation(fields: [productId], references: [id])
  productId Int
  quantity  Int
  price     Float // snapshot of price at purchase time
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Home {
  id              Int               @id @default(autoincrement())
  title           String?
  sub_title       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  bannerImg       Image[]
  categories_card ProductCategory[]
}
